pipeline
{
  agent any

  parameters {
    string(
      name: 'LASTNAME',
      defaultValue: 'Bullock',
      description: 'Enter a surname'
    )
    choice(
      name: 'select _environment',
      choices: ['dev', 'prod'],
      description: 'Select deployment environment'
    )
  }

  environment {
    NAME = 'Seth'
  }

  tools {
    maven 'mymaven'
  }

  stages {
    stage('build')
    {
        steps {
          script {
            def helper = load 'jenkins/scripts/script.groovy'
            helper.hello()
          }

          bat 'mvn clean package -DskipTests=true'
          echo "Hello, $NAME ${params.LASTNAME}!"
        }
    }

    stage('test') {
      parallel {
        stage('testA') {
          steps {
            echo 'Running test A...'
          }
        }

        stage('testB') {
          steps {
            echo 'Running test B...'
          }
        }
      }

      post {
        success {
          echo 'Stashing the JAR...'

          stash(
            name: 'maven-build',
            includes: 'target/*.jar'
          )

          echo 'Archiving the JAR...'

          archiveArtifacts artifacts: 'target/*.jar'
        }
      }
    }

    stage('deploy_dev') {
      when {
        expression {
          params.select_environment == 'dev'
        }

        beforeAgent true
      }

      steps {
          unstash 'maven-build'

          echo 'Simulating deployment to DEVELOPMENT...'

          bat 'dir target'
      } // end of steps for stage deploy-dev
    } // end of stage deploy-dev

    stage('deploy_prod') {
      when {
        expression {
            params.select_environment == 'prod'
        }
        beforeAgent true
      }
      steps {
        unstash 'maven-build'
        echo 'Simulating deployment to PRODUCTION...'
        bat 'dir target'
      }
    }
  } // end of stages
}
