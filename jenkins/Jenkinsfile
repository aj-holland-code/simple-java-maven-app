pipeline
{
  agent any

  parameters {
    string defaultValue: 'Bullock', name: 'LASTNAME'
  }


  environment {
    NAME = "Seth"
  }

  tools {
    maven 'mymaven'
  }


  stages {
    stage('build')
    {
      steps {
        bat 'mvn clean package'
        echo "hello $NAME ${params.LASTNAME}"
      }

      post {
        success {
          // One or more steps need to be included within each condition's block.
          archiveArtifacts artifacts: '**/target/*.jar'
        }
      }
    }
  }
}
